# 复制本文件为 .env 并填写本地配置（.env 已被忽略，不会纳入版本管理）
# EMAIL_PASS 填邮箱服务商的「授权码」，不是邮箱登录密码
# 在 CI 环境中请通过仓库 Secrets 提供，不要写进代码或提交记录

SMTP_HOST=smtp.yeah.net
SMTP_PORT=465
EMAIL_USER=你的邮箱@example.com
EMAIL_PASS=你的邮箱授权码
SMTP_FROM=你的邮箱@example.com

# 管理员初始账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=改成你自己的管理员密码

# 运行快照加密密钥（可选；留空时由服务端私密配置派生）
DATA_KEY=
